@using project_5.Models.Entities
@model List<Car>



@{
    ViewData["Title"] = "Nos Voitures";
}

<div class="centered-container">

    <h1 class="page-title">Nos Voitures</h1>

    @if (User.IsInRole("Admin"))
    {
        <a class="btn btn-custom" href="@Url.Action("AddCarForm", "CarList")"> + Ajouter une Voiture</a>
    }

    <div class="car-grid">
        @foreach (var car in Model)
        {
            <div class="car-item">
                <a href="@Url.Action("CarDetails", "CarList", new { id = car.Id })">
                    <div class="car-content">
                        <img src="@car.UrlPhoto" alt="Car Image" />
                        <div class="car-info">
                            <strong>@car.Brand.Name - @car.CarModel.Model</strong> (@car.Year)
                            <p>Finition: @car.Finition</p>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
</div>