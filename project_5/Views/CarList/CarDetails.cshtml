@model project_5.Models.Entities.Car

<h1>Car Details</h1>

<p><strong>Brand:</strong> @Model.Brand.Name</p>
<p><strong>Model:</strong> @Model.CarModel.Model</p>
<p><strong>Year:</strong> @Model.Year</p>
<p><strong>Sale Price:</strong> @Model.SalePrice</p>
<p><strong>Purchase Price:</strong> @Model.PurchasePrice</p>
<p><strong>Finition:</strong> @Model.Finition</p>
<p><strong>Available Date:</strong> @Model.AvailableDate</p>
<p><strong>Purchase Date:</strong> @Model.PurchaseDate</p>
<p><strong>Sale Date:</strong> @Model.SaleDate</p>
<p><strong>Photo:</strong> <img src="@Model.UrlPhoto" alt="Car Photo" /></p>
