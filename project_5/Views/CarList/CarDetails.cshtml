@using project_5.Models.Entities
@model Car

<h1>Car Details</h1>

<p><strong>Brand:</strong> @Model.Brand.Name</p>
<p><strong>Model:</strong> @Model.CarModel.Model</p>
<p><strong>Year:</strong> @Model.Year</p>
<p><strong>Sale Price:</strong> @Model.SalePrice</p>
<p><strong>Purchase Price:</strong> @Model.PurchasePrice</p>
<p><strong>Finition:</strong> @Model.Finition</p>
<p><strong>Available Date:</strong> @Model.AvailableDate</p>
<p><strong>Purchase Date:</strong> @Model.PurchaseDate</p>
<p><strong>Sale Date:</strong> @Model.SaleDate</p>
<p><strong>Photo:</strong> <img src="@Model.UrlPhoto" alt="Car Photo" /></p>


<!-- Formulaire pour supprimer la voiture si admin-->
@if (User.IsInRole("Admin"))
{
    <br>
    <a asp-action="EditCar" asp-route-id="@Model.Id" class="btn btn-primary">Edit Car</a>
    <br>
    <a asp-action="AddCarForm" class="btn btn-primary">Add a new car</a>
    <br>

    <form asp-action="DeleteCar" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this car?');">
        <button type="submit" class="btn btn-danger">Delete Car</button>
    </form>
    <br>
    <a asp-action="Cars" class="btn btn-primary">Back to Cars</a>
    <br>
}