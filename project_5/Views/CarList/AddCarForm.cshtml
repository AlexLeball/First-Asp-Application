@using project_5.Models.ViewModels
@model AddCarViewModel

<form asp-controller="CarList" asp-action="AddCar" method="post" enctype="multipart/form-data">
    <div class="form-container">
        <h1 class="page-title">Ajouter une voiture</h1>

        <!-- Sélection de la marque -->
        <div class="form-group">
            <label for="brandDropdown">Marque</label>
            <div class="d-flex align-items-start">
                <select id="brandDropdown" name="BrandId" class="form-control" required aria-required="true">
                    <option value="">-- Sélectionner une marque --</option>
                    @foreach (var brand in Model.Brands)
                    {
                        <option value="@brand.Id">@brand.Name</option>
                    }
                </select>
                <button type="button"
                        class="btn btn-secondary ms-2"
                        data-bs-toggle="modal"
                        data-bs-target="#addBrandModal"
                        aria-label="Ajouter une nouvelle marque">
                    + Nouvelle marque
                </button>
            </div>
            <span class="text-danger" asp-validation-for="BrandId" role="alert" aria-live="assertive"></span>
        </div>

        <!-- Sélection du modèle -->
        <div class="form-group mt-3">
            <label for="carModelDropdown">Modèle</label>
            <div class="d-flex align-items-start">
                <select id="carModelDropdown" name="CarModelId" class="form-control" required aria-required="true">
                    <option value="">-- Sélectionner un modèle --</option>
                    @foreach (var carModel in Model.CarModels)
                    {
                        <option value="@carModel.Id">@carModel.Model</option>
                    }
                </select>
                <button type="button"
                        class="btn btn-secondary ms-2"
                        data-bs-toggle="modal"
                        data-bs-target="#addCarModelModal"
                        aria-label="Ajouter un nouveau modèle">
                    + Nouveau modèle
                </button>
            </div>
            <span class="text-danger" asp-validation-for="CarModelId" role="alert" aria-live="assertive"></span>
        </div>

        <!-- Informations supplémentaires -->
        <div class="form-group mt-3">
            <label for="year">Année</label>
            <select id="year" name="Year" class="form-control" required aria-required="true">
                <option value="">-- Sélectionner une année --</option>
                @for (int i = DateTime.Now.Year; i >= 1990; i--)
                {
                    <option value="@i">@i</option>
                }
            </select>
            <span class="text-danger" asp-validation-for="Year" role="alert" aria-live="assertive"></span>
        </div>

        <div class="form-group mt-3">
            <label for="finition">Finition</label>
            <input type="text" id="finition" name="Finition" class="form-control" required aria-required="true" />
            <span class="text-danger" asp-validation-for="Finition" role="alert" aria-live="assertive"></span>
        </div>

        <div class="form-group mt-3">
            <label for="purchasePrice">Prix d'achat</label>
            <input type="number" id="purchasePrice" name="PurchasePrice" class="form-control" required aria-required="true" />
            <span class="text-danger" asp-validation-for="PurchasePrice" role="alert" aria-live="assertive"></span>
        </div>

        <div class="form-group mt-3">
            <label for="availableDate">Disponible à partir du</label>
            <input type="date" id="availableDate" name="AvailableDate" class="form-control" required aria-required="true" />
            <span class="text-danger" asp-validation-for="AvailableDate" role="alert" aria-live="assertive"></span>
        </div>

        <div class="form-group mt-3">
            <label for="CarPhotoFile">Photo de la voiture</label>
            <input type="file" id="CarPhotoFile" name="CarPhotoFile" class="form-control" aria-describedby="fileHelp" />
            <small id="fileHelp" class="form-text text-muted">Format accepté : JPG, PNG.</small>
            <span class="text-danger" asp-validation-for="CarPhotoFile" role="alert" aria-live="assertive"></span>
        </div>

        <!-- Section réparation -->
        <fieldset class="form-group mt-4">
            <legend class="h4">Réparations</legend>

            <label for="repairPrice">Prix de la réparation</label>
            <input type="number" id="repairPrice" name="Repairs[0].Price" class="form-control" />
            <span class="text-danger" asp-validation-for="Repairs[0].Price" role="alert" aria-live="assertive"></span>

            <label for="repairDescription" class="mt-3">Description de la réparation</label>
            <textarea id="repairDescription" name="Repairs[0].Description" class="form-control"></textarea>
            <span class="text-danger" asp-validation-for="Repairs[0].Description" role="alert" aria-live="assertive"></span>
        </fieldset>

        <!-- Success message -->
        <div id="repairMessage" class="alert alert-success mt-3 d-none" role="alert" aria-live="polite">
            Réparation ajoutée avec succès !
        </div>

        <div id="repairsContainer" aria-live="polite"></div>

        <div class="btn-custom-add-space">
            <button type="button" class="btn btn-custom-add mt-3" onclick="addRepair()">Ajouter la réparation</button>
            <button type="submit" class="btn btn-custom-add mt-3" onclick="return validateForm()">Ajouter la voiture</button>

        </div>

        <!-- Modal : Ajouter une marque -->
        <div class="modal fade" id="addBrandModal" tabindex="-1" aria-labelledby="addBrandModalLabel" aria-hidden="true" role="dialog">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="addBrandModalLabel">Ajouter une marque</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                    </div>
                    <div class="modal-body">
                        <label for="newBrandName" class="form-label">Nom de la marque</label>
                        <input type="text" id="newBrandName" class="form-control" placeholder="Nom de la marque" aria-describedby="brandErrorMessage" />
                        <span id="brandErrorMessage" class="text-danger" role="alert" aria-live="assertive"></span>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-custom" data-bs-dismiss="modal">Annuler</button>
                        <button type="button" class="btn btn-custom" onclick="addBrand()">Ajouter la marque</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Modal : Ajouter un modèle -->
        <div class="modal fade" id="addCarModelModal" tabindex="-1" aria-labelledby="addCarModelModalLabel" aria-hidden="true" role="dialog">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="addCarModelModalLabel">Ajouter un modèle</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                    </div>
                    <div class="modal-body">
                        <label for="newCarModelName" class="form-label">Nom du modèle</label>
                        <input type="text" id="newCarModelName" class="form-control" placeholder="Nom du modèle" aria-describedby="carModelErrorMessage" />
                        <span id="carModelErrorMessage" class="text-danger" role="alert" aria-live="assertive"></span>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-custom" data-bs-dismiss="modal">Annuler</button>
                        <button type="button" class="btn btn-custom" onclick="addCarModel()">Ajouter le modèle</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

<script>
    var repairCount = 1;

    function addRepair() {
        // Get current values (first repair inputs)
        const priceInput = document.getElementById('repairPrice');
        const descInput = document.getElementById('repairDescription');
        const price = priceInput?.value.trim();
        const desc = descInput?.value.trim();

        // Only proceed if either value is filled in
        if (!price && !desc) {
            return; // Do nothing if both are empty
        }

        // Create a new repair fieldset
        var repairSection = document.createElement('fieldset');
        repairSection.classList.add('form-group', 'mt-3');
        repairSection.innerHTML = `
            <legend class="h6">Réparation ${repairCount + 1}</legend>
            <label for="repairPrice_${repairCount}">Prix de la réparation</label>
            <input type="number" id="repairPrice_${repairCount}" name="Repairs[${repairCount}].Price" class="form-control" />

            <label for="repairDescription_${repairCount}" class="mt-3">Description de la réparation</label>
            <textarea id="repairDescription_${repairCount}" name="Repairs[${repairCount}].Description" class="form-control"></textarea>
        `;
        document.getElementById('repairsContainer').appendChild(repairSection);

        repairCount++;

        // Show success message
        const messageEl = document.getElementById('repairMessage');
        messageEl.classList.remove('d-none');
        messageEl.textContent = "Réparation ajoutée avec succès !";

        setTimeout(() => {
            messageEl.classList.add('d-none');
        }, 3000);

      
    }

    function addBrand() {
        const brandName = document.getElementById('newBrandName').value.trim();
        const brandError = document.getElementById('brandErrorMessage');

        if (!brandName) {
            brandError.innerText = "Veuillez entrer un nom de marque.";
            return;
        }

        // Check if the brand already exists in the dropdown
        const brandDropdown = document.getElementById('brandDropdown');
        const existingBrands = Array.from(brandDropdown.options).map(opt => opt.text.toLowerCase());

        if (existingBrands.includes(brandName.toLowerCase())) {
            brandError.innerText = "Cette marque existe déjà.";
            return;
        }

        // If valid, clear error and continue to send to server
        brandError.innerText = "";

        fetch('/CarList/AddBrand', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ BrandName: brandName }),
        })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    brandDropdown.innerHTML = '<option value="">-- Sélectionner une marque --</option>';
                    data.brands.forEach(brand => {
                        const option = document.createElement("option");
                        option.value = brand.id;
                        option.text = brand.name;
                        brandDropdown.appendChild(option);
                    });
                    $('#addBrandModal').modal('hide');
                } else {
                    brandError.innerText = data.message;
                }
            });
    }

    function addCarModel() {
        const modelName = document.getElementById('newCarModelName').value.trim();
        const modelError = document.getElementById('carModelErrorMessage');

        if (!modelName) {
            modelError.innerText = "Veuillez entrer un nom de modèle.";
            return;
        }

        // Check if the model already exists in the dropdown
        const carModelDropdown = document.getElementById('carModelDropdown');
        const existingModels = Array.from(carModelDropdown.options).map(opt => opt.text.toLowerCase());

        if (existingModels.includes(modelName.toLowerCase())) {
            modelError.innerText = "Ce modèle existe déjà.";
            return;
        }

        // If valid, clear error and send to server
        modelError.innerText = "";

        fetch('/CarList/AddCarModel', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ ModelName: modelName }),
        })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    carModelDropdown.innerHTML = '<option value="">-- Sélectionner un modèle --</option>';
                    data.carModels.forEach(carModel => {
                        const option = document.createElement("option");
                        option.value = carModel.id;
                        option.text = carModel.model;
                        carModelDropdown.appendChild(option);
                    });
                    $('#addCarModelModal').modal('hide');
                } else {
                    modelError.innerText = data.message;
                }
            });
    }

    // Validate form before submission
    function validateForm() {
    const brand = document.getElementById('brandDropdown').value.trim();
    const model = document.getElementById('carModelDropdown').value.trim();
    const year = document.getElementById('year').value.trim();
    const finition = document.getElementById('finition').value.trim();
    const purchasePrice = document.getElementById('purchasePrice').value.trim();
    const availableDate = document.getElementById('availableDate').value.trim();
    const fileInput = document.getElementById('CarPhotoFile');
    const file = fileInput.files[0];

    // Basic required field checks
    if (!brand || !model || !year || !finition || !purchasePrice || !availableDate) {
        alert("Veuillez remplir tous les champs obligatoires.");
        return false;
    }

    // Photo is required
    if (!file) {
        alert("Veuillez sélectionner une photo de la voiture.");
        return false;
    }

    // Validate file type
    const allowedTypes = ['image/jpeg', 'image/png'];
    if (!allowedTypes.includes(file.type)) {
        alert("Format de fichier invalide. Veuillez choisir un fichier JPG ou PNG.");
        return false;
    }

    // Optional: Validate repair if entered
    const repairPrice = document.getElementById('repairPrice').value.trim();
    const repairDesc = document.getElementById('repairDescription').value.trim();
    if ((repairPrice && isNaN(repairPrice)) || (repairPrice && !repairDesc)) {
        alert("Si une réparation est renseignée, assurez-vous que le prix est un nombre valide et que la description est fournie.");
        return false;
    }

    return true; // Allow form submission
}

</script>
