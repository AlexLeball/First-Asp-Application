@using project_5.Models.ViewModels
@model EditCarViewModel

<h1>Modifier une voiture</h1>

<form asp-action="EditCar" method="post" enctype="multipart/form-data">

<div class="form-container">
    <div class="form-group">
        <label for="BrandId">Marque</label>
        <select asp-for="BrandId" class="form-control" asp-items="@(new SelectList(Model.Brands, "Id", "Name"))">
                <option value="">-- Sélectionner une marque --</option>
        </select>
    </div>

    <div class="form-group">
            <label for="CarModelId">Modèle</label>
        <select asp-for="CarModelId" class="form-control" asp-items="@(new SelectList(Model.CarModels, "Id", "Model"))">
                <option value="">-- Sélectionner un modèle --</option>
        </select>
    </div>

    <div class="form-group mt-3">
        <label for="year">Année</label>
        <select id="year" name="Year" class="form-control" required>
                <option value="">Sélectionner une année</option>
            @for (int i = DateTime.Now.Year; i >= 1990; i--)
            {
                    if (Model.Year == i)
                    {
                        <option value="@i" selected="selected">@i</option>
                    }
                    else
                    {
                        <option value="@i">@i</option>
                    }

            }
        </select>
        <span class="text-danger" asp-validation-for="Year"></span>
    </div>

    <div class="form-group">
        <label for="SalePrice">Prix de vente</label>
        <input asp-for="SalePrice" class="form-control" type="number" step="0.01" />
    </div>

    @if (!string.IsNullOrEmpty(Model.UrlPhoto))
    {
        <div class="mb-3">
            <label>Photo actuelle :</label><br />
            <img src="@Model.UrlPhoto" alt="Photo actuelle" class="img-thumbnail" style="max-height:200px;" />
        </div>
    }


    <div class="form-group mt-3">
        <label for="CarPhotoFile">Photo de la voiture (facultative)</label>
        <input type="file" id="CarPhotoFile" name="CarPhotoFile" class="form-control" />
        <span class="text-danger" asp-validation-for="CarPhotoFile"></span>
    </div>

    <div class="form-group">
        <label for="Finition">Finition</label>
        <input asp-for="Finition" class="form-control" type="text" />
    </div>

        <button type="submit" class="btn btn-custom-back">Enregistrer les modifications</button>g
</div>
</form>

