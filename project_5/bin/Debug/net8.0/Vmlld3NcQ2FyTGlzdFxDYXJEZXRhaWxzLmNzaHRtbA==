@using project_5.Models.Entities
@model Car

<div class="container mt-4">
    <h1 class="mb-4">Car Details</h1>

    <div class="card">
        <div class="card-body">
            <!-- Car Image -->
            <p class="text-center">
                <img src="@Model.UrlPhoto" alt="Car Photo" class="img-fluid rounded" style="max-height: 300px;" />
            </p>

            <!-- Car Information -->
            <p><strong>Brand:</strong> @Model.Brand.Name</p>
            <p><strong>Model:</strong> @Model.CarModel.Model</p>
            <p><strong>Year:</strong> @Model.Year</p>
            <p><strong>Sale Price:</strong> $@Model.SalePrice</p>
            <p><strong>Finition:</strong> @Model.Finition</p>
            <p><strong>Available Date:</strong> @Model.AvailableDate.ToString("yyyy-MM-dd")</p>
            <p><strong>Sale Date:</strong> @(Model.SaleDate?.ToString("yyyy-MM-dd") ?? "Not Sold")</p>

            <!-- Car Status -->
            <p>
                <strong>Status:</strong>
                @if (Model.SaleDate.HasValue)
                {
                    if (Model.SaleDate.Value > DateTime.Now)
                    {
                        <span class="badge bg-warning">Pending Sale</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Sold</span>
                    }
                }
                else
                {
                    <span class="badge bg-success">Available</span>
                }
            </p>

            <!-- Admin Actions: Mark as Sold, Edit, Delete -->
            @if (User.IsInRole("Admin"))
            {
                <hr />

                <!-- Mark as Sold Form -->
                <form asp-action="MarkCarAsSold" method="post">
                    <input type="hidden" name="Id" value="@Model.Id" />

                    <div class="form-group">
                        <label for="SaleDate">Set Sale Date</label>
                        <input name="SaleDate" class="form-control" type="date" required />
                    </div>

                    <button type="submit" class="btn btn-success mt-2">Add Sale Date</button>
                </form>

                <hr />

                <!-- Edit Car -->
                <a asp-action="EditCar" asp-route-id="@Model.Id" class="btn btn-primary">Edit Car</a>

                <!-- Delete Car -->
                <form asp-action="DeleteCar" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this car?');">
                    <button type="submit" class="btn btn-danger mt-2">Delete Car</button>
                </form>
            }

            <!-- Back to Cars -->
            <a asp-action="Cars" class="btn btn-secondary mt-3">Back to Cars</a>
        </div>
    </div>
</div>
